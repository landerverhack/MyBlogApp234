@page "/chatgpt"
@layout ChatGPTLayout

<PageTitle>ChatGPT</PageTitle>

<div class="sidebar @(sidebarCollapsed ? "collapsed" : "")">
    <!-- Top section -->
    <div class="sidebar-top">
        <div class="sidebar-header">
            <button class="icon-btn logo-btn" title="ChatGPT">
                <svg width="36" height="36" viewBox="0 0 41 41" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M37.532 16.87a9.963 9.963 0 0 0-.856-8.184 10.078 10.078 0 0 0-10.855-4.835 9.964 9.964 0 0 0-6.239-3.507 10.079 10.079 0 0 0-11.692 4.966 9.967 9.967 0 0 0-6.675 3.476 10.079 10.079 0 0 0-2.484 11.923 9.961 9.961 0 0 0 .856 8.185 10.079 10.079 0 0 0 10.855 4.835 9.965 9.965 0 0 0 6.239 3.507 10.079 10.079 0 0 0 11.692-4.966 9.965 9.965 0 0 0 6.675-3.476 10.079 10.079 0 0 0 2.484-11.923Zm-14.017 19.626a7.479 7.479 0 0 1-4.799-1.735c.061-.033.168-.091.237-.134l7.964-4.6a1.294 1.294 0 0 0 .655-1.134V19.054l3.366 1.944a.12.12 0 0 1 .066.092v9.299a7.505 7.505 0 0 1-7.49 7.507ZM4.661 30.358a7.471 7.471 0 0 1-.894-5.023c.06.036.162.099.237.141l7.964 4.6a1.297 1.297 0 0 0 1.308 0l9.724-5.614v3.888a.12.12 0 0 1-.048.103l-8.051 4.649a7.504 7.504 0 0 1-10.24-2.744ZM3.408 13.514a7.471 7.471 0 0 1 3.903-3.282v9.458a1.294 1.294 0 0 0 .654 1.132l9.723 5.614-3.366 1.944a.12.12 0 0 1-.114.012L5.16 23.86a7.504 7.504 0 0 1-1.752-10.346Zm27.063 6.439-9.724-5.615 3.367-1.943a.121.121 0 0 1 .114-.012l9.048 5.228a7.498 7.498 0 0 1-1.158 13.528v-9.476a1.293 1.293 0 0 0-.647-1.71Zm3.35-5.043c-.059-.037-.162-.099-.236-.141l-7.965-4.6a1.298 1.298 0 0 0-1.308 0l-9.723 5.614v-3.888a.12.12 0 0 1 .048-.103l8.05-4.645a7.497 7.497 0 0 1 11.135 7.763Zm-21.063 6.929-3.367-1.944a.12.12 0 0 1-.065-.092v-9.299a7.497 7.497 0 0 1 12.293-5.756 6.94 6.94 0 0 0-.236.134l-7.965 4.6a1.294 1.294 0 0 0-.654 1.132l-.006 11.225Zm1.829-3.943 4.33-2.501 4.332 2.5v4.999l-4.331 2.5-4.331-2.5V17.896Z" fill="currentColor"/>
                </svg>
            </button>
            <button class="icon-btn toggle-btn" title="Toggle sidebar" @onclick="ToggleSidebar">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <line x1="9" y1="3" x2="9" y2="21"/>
                </svg>
            </button>
        </div>

        <div class="sidebar-nav">
            <button class="nav-item active" @onclick="NewChat">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"/>
                </svg>
                <span>New chat</span>
            </button>

            <button class="nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="m21 21-4.35-4.35"/>
                </svg>
                <span>Search chats</span>
            </button>

            <button class="nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                </svg>
                <span>Images</span>
            </button>

            <button class="nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="3" width="20" height="14" rx="2"/>
                    <path d="M8 21h8M12 17v4"/>
                </svg>
                <span>Apps</span>
            </button>

            <button class="nav-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <line x1="2" y1="12" x2="22" y2="12"/>
                    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
                <span>Deep research</span>
            </button>
        </div>
    </div>

    <!-- Bottom section -->
    <div class="sidebar-bottom">
        <button class="nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM12 8v8M8 12h8"/>
            </svg>
            <span>See plans and pricing</span>
        </button>

        <button class="nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.07 4.93a10 10 0 0 1 0 14.14M4.93 4.93a10 10 0 0 0 0 14.14"/>
            </svg>
            <span>Settings</span>
        </button>

        <button class="nav-item">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/>
                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3M12 17h.01"/>
            </svg>
            <span>Help</span>
        </button>

        <div class="login-promo">
            <p class="promo-title">Get responses tailored to you</p>
            <p class="promo-text">Log in to get answers based on saved chats, plus create images and upload files.</p>
            <button class="login-promo-btn">Log in</button>
        </div>
    </div>
</div>

<!-- Main content area -->
<div class="main-content">
    <!-- Header -->
    <div class="main-header">
        <div class="header-title">
            <span>ChatGPT</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
            </svg>
        </div>
        <div class="header-actions">
            <button class="btn-login">Log in</button>
            <button class="btn-signup">Sign up for free</button>
        </div>
    </div>

    <!-- Center content -->
    <div class="chat-area">
        <div class="welcome-section">
            <h1 class="welcome-heading">Where should we begin?</h1>
        </div>

        <!-- Message input -->
        <div class="input-container">
            <div class="input-wrapper">
                <button class="input-action-btn plus-btn" title="Attach">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                </button>
                <textarea
                    class="message-input"
                    placeholder="Ask anything"
                    rows="1"
                    @bind="messageText"
                    @onkeydown="HandleKeyDown"
                    @oninput="AutoResize">
                </textarea>
                <div class="input-right-actions">
                    <button class="input-action-btn mic-btn" title="Voice input">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                            <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                            <line x1="12" y1="19" x2="12" y2="23"/>
                            <line x1="8" y1="23" x2="16" y2="23"/>
                        </svg>
                    </button>
                    <button class="voice-btn" title="Voice mode">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/>
                            <line x1="8" y1="10" x2="8" y2="14"/>
                            <line x1="12" y1="8" x2="12" y2="16"/>
                            <line x1="16" y1="10" x2="16" y2="14"/>
                        </svg>
                        <span>Voice</span>
                    </button>
                </div>
            </div>
        </div>

        <p class="disclaimer">
            By messaging ChatGPT, an AI chatbot, you agree to our
            <a href="#" class="disclaimer-link">Terms</a> and have read our
            <a href="#" class="disclaimer-link">Privacy Policy</a>.
        </p>
    </div>
</div>

@code {
    private bool sidebarCollapsed = false;
    private string messageText = string.Empty;

    private void ToggleSidebar() => sidebarCollapsed = !sidebarCollapsed;

    private void NewChat() => messageText = string.Empty;

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            SendMessage();
        }
    }

    private void AutoResize(ChangeEventArgs e)
    {
        messageText = e.Value?.ToString() ?? string.Empty;
    }

    private void SendMessage()
    {
        if (!string.IsNullOrWhiteSpace(messageText))
        {
            messageText = string.Empty;
        }
    }
}

<style>
    /* ---- Layout ---- */
    .sidebar {
        width: 260px;
        min-width: 260px;
        background: #171717;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 8px 0;
        transition: width 0.2s ease, min-width 0.2s ease, opacity 0.2s ease;
        overflow: hidden;
    }

    .sidebar.collapsed {
        width: 0;
        min-width: 0;
        opacity: 0;
        pointer-events: none;
    }

    .main-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        background: #212121;
    }

    /* ---- Sidebar header ---- */
    .sidebar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px;
        margin-bottom: 4px;
    }

    .sidebar-top, .sidebar-bottom {
        display: flex;
        flex-direction: column;
    }

    .sidebar-bottom {
        padding: 8px 0;
    }

    /* ---- Icon buttons ---- */
    .icon-btn {
        background: none;
        border: none;
        color: #ececec;
        cursor: pointer;
        padding: 8px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s;
    }

    .icon-btn:hover {
        background: #2a2a2a;
    }

    /* ---- Nav items ---- */
    .nav-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 8px 12px;
        margin: 1px 8px;
        background: none;
        border: none;
        color: #ececec;
        cursor: pointer;
        border-radius: 8px;
        font-size: 14px;
        text-align: left;
        width: calc(100% - 16px);
        white-space: nowrap;
        transition: background 0.15s;
    }

    .nav-item:hover {
        background: #2a2a2a;
    }

    .nav-item.active {
        background: #2a2a2a;
    }

    .sidebar-nav {
        display: flex;
        flex-direction: column;
    }

    /* ---- Login promo ---- */
    .login-promo {
        margin: 12px 8px;
        padding: 14px;
        border-radius: 12px;
        background: #2a2a2a;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .promo-title {
        font-size: 14px;
        font-weight: 600;
        color: #ececec;
        margin: 0;
    }

    .promo-text {
        font-size: 13px;
        color: #8e8ea0;
        margin: 0;
        line-height: 1.4;
    }

    .login-promo-btn {
        background: #ececec;
        color: #212121;
        border: none;
        border-radius: 20px;
        padding: 8px 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 4px;
        transition: background 0.15s;
    }

    .login-promo-btn:hover {
        background: #d9d9d9;
    }

    /* ---- Main header ---- */
    .main-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 16px;
        min-height: 52px;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 16px;
        font-weight: 600;
        color: #ececec;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 8px;
    }

    .header-title:hover {
        background: #2a2a2a;
    }

    .header-actions {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .btn-login {
        background: #212121;
        color: #ececec;
        border: 1px solid #555;
        border-radius: 20px;
        padding: 6px 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-login:hover {
        background: #2a2a2a;
    }

    .btn-signup {
        background: #ececec;
        color: #212121;
        border: none;
        border-radius: 20px;
        padding: 6px 16px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.15s;
    }

    .btn-signup:hover {
        background: #d9d9d9;
    }

    /* ---- Chat area ---- */
    .chat-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 0 16px 24px;
        gap: 32px;
    }

    .welcome-section {
        text-align: center;
    }

    .welcome-heading {
        font-size: 32px;
        font-weight: 600;
        color: #ececec;
        margin: 0;
        letter-spacing: -0.5px;
    }

    /* ---- Input area ---- */
    .input-container {
        width: 100%;
        max-width: 672px;
    }

    .input-wrapper {
        display: flex;
        align-items: center;
        background: #2f2f2f;
        border-radius: 24px;
        padding: 10px 12px;
        gap: 8px;
        border: 1px solid #444;
        transition: border-color 0.15s;
    }

    .input-wrapper:focus-within {
        border-color: #666;
    }

    .message-input {
        flex: 1;
        background: none;
        border: none;
        color: #ececec;
        font-size: 16px;
        outline: none;
        resize: none;
        max-height: 200px;
        line-height: 1.5;
        font-family: inherit;
    }

    .message-input::placeholder {
        color: #8e8ea0;
    }

    .input-right-actions {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .input-action-btn {
        background: none;
        border: none;
        color: #8e8ea0;
        cursor: pointer;
        padding: 6px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.15s, color 0.15s;
    }

    .input-action-btn:hover {
        background: #3a3a3a;
        color: #ececec;
    }

    .voice-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        background: #3a3a3a;
        border: none;
        color: #ececec;
        cursor: pointer;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.15s;
    }

    .voice-btn:hover {
        background: #444;
    }

    /* ---- Disclaimer ---- */
    .disclaimer {
        font-size: 12px;
        color: #8e8ea0;
        text-align: center;
        max-width: 500px;
        line-height: 1.4;
        margin: 0;
    }

    .disclaimer-link {
        color: #8e8ea0;
        text-decoration: underline;
    }

    .disclaimer-link:hover {
        color: #ececec;
    }
</style>
